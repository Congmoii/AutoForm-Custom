{
  "manifest_version": 3,
  "name": "AutoForm-Custom",
  "version": "4.0.15",
  "version_name": "v4.0.15",
  "description": "Quét và tự động điền một Google Form theo tỷ lệ, CSV hoặc lịch chạy.",
  "key": "",
  "action": { "default_popup": "dist-popup/index.html", "default_title": "AutoForm-Custom", "default_icon": { "16": "Images/AutoForm-Star-16.png", "32": "Images/AutoForm-Star-32.png", "48": "Images/AutoForm-Star-48.png", "128": "Images/AutoForm-Star-128.png" } },
  "background": { "service_worker": "background.js", "type": "module" },
  "content_scripts": [{
    "matches": ["https://docs.google.com/forms/*"],
    "js": ["content.js"],
    "run_at": "document_idle"
  }],
  "permissions": ["storage", "alarms", "tabs", "scripting"],
  "host_permissions": ["https://docs.google.com/forms/*"],
  "web_accessible_resources": [{
    "resources": ["fill-engine.mjs", "step-protocol.mjs"],
    "matches": ["https://docs.google.com/*"]
  }],
  "icons": { "16": "Images/AutoForm-Star-16.png", "32": "Images/AutoForm-Star-32.png", "48": "Images/AutoForm-Star-48.png", "128": "Images/AutoForm-Star-128.png" }
}
